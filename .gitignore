.DS_Store
node_modules/
dist/
.build/
target/

# Build output (Docker builds everything from source)
*.wasm
web/artifacts/
web/public/vendor/grass-sift.js
web/public/vendor/opencv.js
web/*.js
web/tests/*.bundle
metal/grass_solver
cuda/grass_solver
cuda/grass_solver.exe
**/*.o
**/*.metallib
**/*.ptx
**/*.cubin

# Test, benchmark and run output (keep sources and fixtures)
*.log
*.stderr
*.stdout
**/*TEST_LOG*
**/BENCHMARK.txt
**/BENCH_M*.json
web/tests/*-result.json
web/tests/*-WebGPU.json
web/tests/APPLE-UI-QA.json
bench-*/

# Generated formation outputs (fixtures live in */fixtures/)
formation*.txt
!**/fixtures/*.txt

__pycache__/
*.py[cod]

# Reproducible measurements belong in external run artifacts, not source control.
prototype/benchmark-results/
prototype/followup-results/
prototype/improvement-results/
